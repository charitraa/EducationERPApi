# =============================================================================
# EducationERP — environment configuration
#
# Copy to .env and adjust:   cp .env.example .env
# Never commit the real .env — it is gitignored.
#
# Every variable below is read by config/settings/*.py. The listed value is
# the setting's own default unless marked REQUIRED, so you only need to edit
# what actually differs for your machine or deployment.
#
# Legend:  [all] every environment   [dev] development.py   [prod] production.py
#
# Exception: DEV_DATABASE below is set to mysql, the team's dev database;
# with no value at all, development.py falls back to sqlite.
# =============================================================================

# -----------------------------------------------------------------------------
# NOT read from this file — DJANGO_SETTINGS_MODULE must be a real environment
# variable, because it is consumed by manage.py/wsgi.py before .env is parsed.
#   manage.py  -> config.settings.development (config.settings.test when testing)
#   wsgi/asgi  -> config.settings.production
# Export it in your shell, systemd unit or container spec to override:
#   export DJANGO_SETTINGS_MODULE=config.settings.production
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# Core                                                                    [all]
# -----------------------------------------------------------------------------
# REQUIRED in production, which refuses to start on a key shorter than 50
# characters or on this placeholder. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-to-a-long-random-string

# Never True in production — it leaks tracebacks and settings to the browser.
DEBUG=True

# Comma-separated hostnames Django will serve. Ignored in development, which
# forces ["*"]. REQUIRED in production.
ALLOWED_HOSTS=localhost,127.0.0.1

TIME_ZONE=UTC

# How many proxies (load balancer, nginx) sit in front of the app. The client
# IP for rate limits and the audit log is taken from the X-Forwarded-For entry
# the outermost of them added. 0 = no proxy: use the connection's address and
# ignore the header, which clients can fake. Set it to match the deployment:
# too low and every client shares the proxy's IP; too high and clients can
# spoof their address again.
NUM_PROXIES=0


# -----------------------------------------------------------------------------
# Authentication / JWT                                                    [all]
# -----------------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Rate limits, "<number>/<period>" with period one of sec, min, hour, day.
# Counted in the cache (Redis in production, shared by all workers).
# Login attempts per client IP:
THROTTLE_LOGIN=10/min
# Every other request, per client IP when logged out and per user when in:
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
# Attendance devices posting punches to /api/v1/attendance/device-punches/, per device.
THROTTLE_DEVICE=120/min
# Public application forms (no account, e.g. admission), per client IP.
THROTTLE_PUBLIC_APPLICATIONS=20/hour
# Reading public forms and vacancies (a page view), per client IP.
THROTTLE_PUBLIC_READ=300/hour
# File uploads (e.g. résumés), per user.
THROTTLE_UPLOADS=30/hour
# Requests per API key that has no rate of its own.
THROTTLE_API_KEY=300/min
# Public signup and resending its link, per client address.
THROTTLE_SIGNUP=10/hour
# Organization-code availability and verification-link checks, per address.
THROTTLE_SIGNUP_CHECK=60/min
# Forgot-password requests and confirmations, per address.
THROTTLE_PASSWORD_RESET=10/hour

# Uploaded files: where they are kept, never under the public media folder.
# Empty: backend/private/ (/app/private in the container). And the largest
# upload accepted, in bytes.
PRIVATE_MEDIA_ROOT=
FILE_UPLOAD_MAX_BYTES=5242880

# Account lockout: after this many failed logins on one account — from any
# address — every attempt is refused, right password included, until the
# window passes with no further failures. Unknown emails lock the same way,
# so the lock reveals nothing. Applies to the API and /admin/ login.
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Public signup (core/signup). Off by default; when on in production it
# needs a CAPTCHA and EMAIL_DELIVERY=django, or the app refuses to start.
SIGNUP_ENABLED=False
# True: a platform admin approves each verified signup before it goes live.
SIGNUP_REQUIRE_APPROVAL=False
# Hours the emailed verification link works.
SIGNUP_TOKEN_HOURS=24
# Frontend pages the emails link to. {token} and {uid} are filled in.
SIGNUP_VERIFY_URL=http://localhost:5173/signup/verify?token={token}
PASSWORD_RESET_URL=http://localhost:5173/reset-password?uid={uid}&token={token}
# Minutes a password-reset link works.
PASSWORD_RESET_MINUTES=60
# Comma-separated throwaway-mail domains to refuse, on top of the built-in list.
SIGNUP_BLOCKED_EMAIL_DOMAINS=
# Emails one address can receive per hour from signup, resend and reset.
EMAILS_PER_ADDRESS_PER_HOUR=5

# CAPTCHA on no-login forms (signup, public applications):
# off | turnstile | hcaptcha | recaptcha. The site key goes to the browser;
# the secret key stays here.
CAPTCHA_PROVIDER=off
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
# reCAPTCHA v3 only: lowest score let through (0.0 bot to 1.0 human).
CAPTCHA_MIN_SCORE=0.5

# API documentation (/api/schema/, /api/docs/, /api/redoc/). True: open to
# anyone, handy locally (this file's values are for development, like
# DEBUG=True above). Set False in production — the default there — to keep
# the docs for staff users only (log in at /admin/ first).
API_DOCS_PUBLIC=True


# -----------------------------------------------------------------------------
# CORS / CSRF                                                             [all]
# -----------------------------------------------------------------------------
# Origins the browser may call the API from. Scheme + host + port, no trailing
# slash. Blank means same-origin only. development.py already defaults to the
# usual Vite/Next ports, so you only set this to add or replace them.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Leave False while the JWT travels in the Authorization header. Set True only
# if you move refresh tokens into cookies — the frontend then also needs
# credentials: "include".
CORS_ALLOW_CREDENTIALS=False

# Seconds a browser may cache a preflight response.
CORS_PREFLIGHT_MAX_AGE=3600

# Origins trusted for CSRF. CORS does not satisfy Django's CSRF origin check,
# so a cookie/session-authenticated SPA needs its origin here too.
# Note: development.py ignores this and mirrors CORS_ALLOWED_ORIGINS instead,
# so it only takes effect in production — where it is REQUIRED if anything
# posts with a session (the Django admin counts).
CSRF_TRUSTED_ORIGINS=https://portal.example.edu


# -----------------------------------------------------------------------------
# Database                                                           [dev/prod]
# Production always uses PostgreSQL. Tests always use in-memory SQLite and
# ignore everything here.
# -----------------------------------------------------------------------------
# Which database development.py uses:                                  [dev]
#   mysql     MySQL 8.4+ / MariaDB 10.6+. Needs the dev requirements:
#             pip install -r requirements-dev.txt
#   postgres  same engine as production
#   sqlite    no server needed, file at backend/db.sqlite3
# Blank or missing falls back to sqlite. The Docker dev stack ignores this
# and always uses its Postgres container.
DEV_DATABASE=mysql

# Connection for mysql/postgres in dev, and for PostgreSQL in production.
# NAME, USER and PASSWORD are REQUIRED there; it raises on startup without
# them, deliberately, rather than silently connecting somewhere wrong.
# Note: python-decouple does not strip trailing "#" comments, so keep comments
# on their own lines or they become part of the value.
DB_NAME=education_erp
DB_USER=education_erp
DB_PASSWORD=
DB_HOST=localhost
# Blank uses the engine's default port: 3306 for MySQL, 5432 for PostgreSQL.
DB_PORT=

# Seconds to keep a connection open for reuse. 0 disables persistent
# connections; keep it at/below your PgBouncer or Postgres idle timeout.
DB_CONN_MAX_AGE=60


# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
# Redis connection for the shared cache. REQUIRED in production.       [prod]
# Format: redis://[:password@]host:port/db   (rediss:// for TLS)
# docker-compose.yml overrides it to point at its own redis service.
REDIS_URL=redis://localhost:6379/0

# Directory for development's file-based cache. Blank uses          [dev]
# backend/.cache/. The Docker dev overlay points it at /tmp so the container
# does not write into your working tree.
CACHE_DIR=


# -----------------------------------------------------------------------------
# Security hardening                                                     [prod]
# -----------------------------------------------------------------------------
# Redirect http -> https. Only set False when TLS terminates at a proxy that
# already does the redirect, or health checks will bounce.
SECURE_SSL_REDIRECT=True

# HSTS lifetime in seconds (31536000 = 1 year). Set 0 while testing — browsers
# honour this for the full duration and it cannot be undone quickly.
SECURE_HSTS_SECONDS=31536000


# -----------------------------------------------------------------------------
# Email                                                              [dev/prod]
# EMAIL_DELIVERY=console only logs mail; django sends it with the SMTP
# settings below. Signup and password resets need django.
# -----------------------------------------------------------------------------
EMAIL_DELIVERY=console
DEFAULT_FROM_EMAIL=Education ERP <no-reply@localhost>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
# For Gmail this is an app password, not the account password.
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True


# -----------------------------------------------------------------------------
# Logging                                                            [all/prod]
# -----------------------------------------------------------------------------
# Root log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.              [all]
LOG_LEVEL=INFO

# Directory for the rotating errors.log that captures 500 tracebacks. [prod]
# Blank uses backend/logs/. Point this at a mounted volume so tracebacks
# survive a redeploy.
LOG_DIR=

# Rotation: size per file in bytes (10485760 = 10 MB) and how many to keep.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# Comma-separated addresses emailed on every 500. Blank disables it entirely;
# it also stays off unless EMAIL_HOST is set.
ADMINS=

